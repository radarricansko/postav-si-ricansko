{
 "name": "[NÁVRH] Postav si Říčansko – publikace world.json (každé 2 h)",
 "flow": [
  {
   "id": 1,
   "module": "datastore:SearchRecord",
   "version": 1,
   "parameters": {
    "datastore": 246351,
    "limit": 100
   },
   "mapper": {
    "filter": [
     [
      {
       "a": "id",
       "o": "exist",
       "b": ""
      }
     ]
    ],
    "sort": [
     {
      "key": "id",
      "order": 1
     }
    ]
   },
   "metadata": {
    "designer": {
